 "version": "v1.6.0.4",
 "_说明": "开发自测用的合成字幕（线性代数·向量组的线性相关性，约 8 分钟）。dev/test-page.html?full=1 会把它当成整片字幕；格式同 B 站字幕 JSON。内容为合成，可手改。",
 "body": [
  {"from":1,"to":4.6,"location":2,"content":"好，同学们，我们开始今天的内容"},
  {"from":4.85,"to":8.45,"location":2,"content":"这一讲我们讲向量组的线性相关性"},
  {"from":8.7,"to":12.78,"location":2,"content":"它是整个线性代数里最核心的概念之一"},
  {"from":13.03,"to":17.11,"location":2,"content":"后面的秩、基、维数全都建立在它上面"},
  {"from":17.36,"to":21.68,"location":2,"content":"我们先简单回顾一下上节课讲的线性组合"},
  {"from":21.93,"to":25.53,"location":2,"content":"给定一组向量 a1 a2 一直到 am"},
  {"from":25.78,"to":29.14,"location":2,"content":"再给一组数 k1 k2 一直到 km"},
  {"from":29.39,"to":34.43,"location":2,"content":"把 k1 乘 a1 加 k2 乘 a2 一直加到 km 乘 am"},
  {"from":34.68,"to":39.72,"location":2,"content":"得到的这个向量就叫做这组向量的一个线性组合"},
  {"from":39.97,"to":44.05,"location":2,"content":"这些系数 k 可以随便取，取遍所有实数"},
  {"from":44.3,"to":48.14,"location":2,"content":"所有线性组合放在一起构成一个集合"},
  {"from":48.39,"to":52.71,"location":2,"content":"这个集合我们说是由这组向量张成的空间"},
  {"from":52.96,"to":57.76,"location":2,"content":"比如平面上两个不共线的向量能张成整个平面"},
  {"from":58.01,"to":62.57,"location":2,"content":"那问题来了，这组向量里面有没有多余的呢"},
  {"from":64.02,"to":69.06,"location":2,"content":"所谓多余，就是某个向量能被其他向量表示出来"},
  {"from":69.31,"to":73.39,"location":2,"content":"把它去掉，张成的空间一点都不会变小"},
  {"from":73.64,"to":76.04,"location":2,"content":"这就引出了今天的定义"},
  {"from":76.29,"to":80.37,"location":2,"content":"如果存在一组不全为零的数 k1 到 km"},
  {"from":80.62,"to":86.38,"location":2,"content":"使得 k1a1 加 k2a2 一直加到 kmam 等于零向量"},
  {"from":86.63,"to":90.47,"location":2,"content":"我们就说向量组 a1 到 am 线性相关"},
  {"from":90.72,"to":93.84,"location":2,"content":"注意这里的关键词是不全为零"},
  {"from":94.09,"to":99.61,"location":2,"content":"全取零的话任何向量组都能凑出零向量，那没有意义"},
  {"from":99.86,"to":103.94,"location":2,"content":"反过来，如果只有 k 全部等于零的时候"},
  {"from":104.19,"to":107.07,"location":2,"content":"这个线性组合才等于零向量"},
  {"from":107.32,"to":110.44,"location":2,"content":"我们就说这个向量组线性无关"},
  {"from":110.69,"to":116.21,"location":2,"content":"这两个定义是互斥的，一个向量组要么相关要么无关"},
  {"from":116.46,"to":120.78,"location":2,"content":"那这个定义和刚才说的多余有什么关系呢"},
  {"from":121.03,"to":126.07,"location":2,"content":"假设向量组线性相关，有一个系数 k1 不等于零"},
  {"from":126.32,"to":132.08,"location":2,"content":"那我们就可以把 k1a1 移到等号另一边，再除以 k1"},
  {"from":132.33,"to":137.13,"location":2,"content":"这样 a1 就被其余向量的线性组合表示出来了"},
  {"from":137.38,"to":142.42,"location":2,"content":"所以线性相关就等价于至少有一个向量是多余的"},
  {"from":142.67,"to":147.47,"location":2,"content":"线性无关就是每个向量都贡献了一个新的方向"},
  {"from":148.92,"to":153.96,"location":2,"content":"定义有了，那给我一组具体的向量，怎么判断呢"},
  {"from":154.21,"to":157.33,"location":2,"content":"我们把 k1 到 km 看成未知数"},
  {"from":157.58,"to":163.58,"location":2,"content":"那么 k1a1 加到 kmam 等于零，其实就是一个方程组"},
  {"from":163.83,"to":167.91,"location":2,"content":"把向量 a1 到 am 按列排成一个矩阵 A"},
  {"from":168.16,"to":171.28,"location":2,"content":"这个方程组就是 A 乘 k 等于零"},
  {"from":171.53,"to":176.09,"location":2,"content":"右边全是零，所以它是一个齐次线性方程组"},
  {"from":176.34,"to":181.38,"location":2,"content":"齐次方程组一定有解，因为 k 全取零就是一个解"},
  {"from":181.63,"to":183.55,"location":2,"content":"我们把它叫做零解"},
  {"from":183.8,"to":189.56,"location":2,"content":"所以问题就变成：这个方程组除了零解还有没有别的解"},
  {"from":189.81,"to":193.41,"location":2,"content":"如果只有零解，向量组就线性无关"},
  {"from":193.66,"to":197.26,"location":2,"content":"如果有非零解，向量组就线性相关"},
  {"from":197.51,"to":202.07,"location":2,"content":"那怎么知道有没有非零解呢，这就要用到秩"},
  {"from":202.32,"to":206.64,"location":2,"content":"我们对矩阵 A 做初等行变换，化成阶梯形"},
  {"from":206.89,"to":210.73,"location":2,"content":"阶梯形里非零行的个数就是矩阵的秩"},
  {"from":210.98,"to":215.54,"location":2,"content":"如果秩等于向量的个数 m，方程组只有零解"},
  {"from":215.79,"to":221.31,"location":2,"content":"如果秩小于 m，就一定有自由未知量，也就有非零解"},
  {"from":221.56,"to":224.92,"location":2,"content":"所以判定方法可以总结成一句话"},
  {"from":225.17,"to":231.17,"location":2,"content":"秩等于向量个数就线性无关，秩小于向量个数就线性相关"},
  {"from":231.42,"to":236.22,"location":2,"content":"顺便说一个推论，向量个数比维数还多的时候"},
  {"from":236.47,"to":240.55,"location":2,"content":"秩不可能超过维数，所以一定线性相关"},
  {"from":242,"to":246.32,"location":2,"content":"下面我们来做一道例题，大家拿笔跟着算"},
  {"from":246.57,"to":252.33,"location":2,"content":"设 a1 等于 1 1 0，a2 等于 0 1 1，a3 等于 1 2 1"},
  {"from":252.58,"to":256.9,"location":2,"content":"判断这三个向量是线性相关还是线性无关"},
  {"from":257.15,"to":261.71,"location":2,"content":"第一步，把三个向量按列排成一个三阶矩阵"},
  {"from":261.96,"to":267.48,"location":2,"content":"第一行是 1 0 1，第二行是 1 1 2，第三行是 0 1 1"},
  {"from":267.73,"to":270.13,"location":2,"content":"第二步，做初等行变换"},
  {"from":270.38,"to":274.7,"location":2,"content":"用第二行减去第一行，第二行变成 0 1 1"},
  {"from":274.95,"to":278.55,"location":2,"content":"这时候第二行和第三行完全一样了"},
  {"from":278.8,"to":283.36,"location":2,"content":"再用第三行减去第二行，第三行就变成全零"},
  {"from":283.61,"to":286.97,"location":2,"content":"化成阶梯形之后只剩两个非零行"},
  {"from":287.22,"to":289.86,"location":2,"content":"所以这个矩阵的秩等于 2"},
  {"from":290.11,"to":293.95,"location":2,"content":"而向量的个数是 3，秩小于向量个数"},
  {"from":294.2,"to":296.84,"location":2,"content":"所以这三个向量线性相关"},
  {"from":297.09,"to":301.89,"location":2,"content":"既然相关，我们能不能把具体的关系找出来呢"},
  {"from":302.14,"to":309.1,"location":2,"content":"回到阶梯形，对应的方程是 k1 加 k3 等于零，k2 加 k3 等于零"},
  {"from":309.35,"to":313.43,"location":2,"content":"k3 是自由未知量，我们令 k3 等于 1"},
  {"from":313.68,"to":317.52,"location":2,"content":"那么 k1 等于负 1，k2 也等于负 1"},
  {"from":317.77,"to":321.85,"location":2,"content":"也就是负 a1 减 a2 加 a3 等于零向量"},
  {"from":322.1,"to":325.22,"location":2,"content":"换句话说 a3 等于 a1 加 a2"},
  {"from":325.47,"to":331.23,"location":2,"content":"大家可以直接验算一下，1 1 0 加 0 1 1 正好是 1 2 1"},
  {"from":331.48,"to":334.6,"location":2,"content":"这里 a3 就是那个多余的向量"},
  {"from":334.85,"to":339.17,"location":2,"content":"去掉它，剩下的 a1 a2 张成的空间不变"},
  {"from":340.62,"to":345.18,"location":2,"content":"我们再从几何上看一下线性相关是什么意思"},
  {"from":345.43,"to":347.59,"location":2,"content":"先看两个向量的情况"},
  {"from":347.84,"to":353.12,"location":2,"content":"两个向量线性相关，就是其中一个是另一个的倍数"},
  {"from":353.37,"to":356.49,"location":2,"content":"在几何上就是这两个向量共线"},
  {"from":356.74,"to":360.34,"location":2,"content":"两个向量不共线，它们就线性无关"},
  {"from":360.59,"to":363.47,"location":2,"content":"再看三维空间里的三个向量"},
  {"from":363.72,"to":369.24,"location":2,"content":"三个向量线性相关，就是其中一个能由另外两个表示"},
  {"from":369.49,"to":373.33,"location":2,"content":"也就是它落在另外两个张成的平面里"},
  {"from":373.58,"to":378.14,"location":2,"content":"所以三个向量线性相关等价于三个向量共面"},
  {"from":378.39,"to":383.43,"location":2,"content":"刚才例题里的 a1 a2 a3 就是三个共面的向量"},
  {"from":383.68,"to":388.48,"location":2,"content":"它们只能张成一个平面，张不成整个三维空间"},
  {"from":388.73,"to":393.77,"location":2,"content":"而三个不共面的向量线性无关，能张成整个空间"},
  {"from":394.02,"to":400.74,"location":2,"content":"所以线性无关的向量个数，其实刻画了空间有多少个独立的方向"},
  {"from":400.99,"to":405.07,"location":2,"content":"这个直觉后面讲维数的时候会非常有用"},
  {"from":406.52,"to":409.88,"location":2,"content":"好，我们来总结一下今天的内容"},
  {"from":410.13,"to":415.65,"location":2,"content":"第一，线性相关是存在不全为零的系数让组合等于零"},
  {"from":415.9,"to":420.46,"location":2,"content":"线性无关是只有全零系数才能组合出零向量"},
  {"from":420.71,"to":426.47,"location":2,"content":"第二，线性相关等价于至少有一个向量能被其余的表示"},
  {"from":426.72,"to":432,"location":2,"content":"第三，判定方法是看齐次线性方程组有没有非零解"},
  {"from":432.25,"to":436.09,"location":2,"content":"实际操作就是求秩，和向量个数比较"},
  {"from":436.34,"to":442.82,"location":2,"content":"第四，几何上两个向量相关就是共线，三个向量相关就是共面"},
  {"from":443.07,"to":446.19,"location":2,"content":"下一讲我们讲极大线性无关组"},
  {"from":446.44,"to":452.44,"location":2,"content":"就是从一个向量组里挑出最多的、彼此线性无关的那几个"},
  {"from":452.69,"to":459.17,"location":2,"content":"它和秩有非常紧密的联系，大家课后先把今天的例题再算一遍"}
 ]
}
